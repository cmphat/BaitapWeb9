# ==========================================
# CẤU HÌNH MÔI TRƯỜNG CHO BÀI TẬP WEB 9
# Copy file này thành .env và điền thông tin thật của bạn
# Lưu ý: Tuyệt đối KHÔNG commit file .env lên Git!
# ==========================================

# Cấu hình Server
SERVER_PORT=8080

# Cấu hình CSDL SQL Server
# Mặc định kết nối SQL Server local, database BaitapWeb9_Security
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=BaitapWeb9_Security;encrypt=false;trustServerCertificate=true;characterEncoding=UTF-8
DB_USERNAME=sa
DB_PASSWORD=your_sa_password_here

# Cấu hình Hibernate (update, create, validate)
DDL_AUTO=update
SHOW_SQL=true

# Cấu hình Spring Mail (Gmail SMTP)
# Để gửi email OTP thật, tạo App Password tại: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Cấu hình Cloudinary (Upload ảnh Product)
# Đăng ký tài khoản miễn phí tại: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
